{
  "manifest_version": 3,
  "name": "简繁通",
  "version": "1.0.0",
  "description": "以兩岸用語詞彙庫轉換網頁簡繁用語，不只是換字形。",
  "minimum_chrome_version": "102",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "简繁通",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["vendor/opencc.js", "vendor/epub-core.js", "terms-data.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-conversion": {
      "suggested_key": {
        "default": "Alt+Shift+J"
      },
      "description": "暫停或恢復本頁轉換"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
